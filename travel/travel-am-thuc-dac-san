      {id:85,tab:"tab4",name:"Chợ Bến Thành (Khu Đặc Sản Khô & Quà Tặng)",cat:"Mua Đặc Sản Làm Quà",stars:4.5,addr:"Đường Lê Lợi, P. Bến Thành, Quận 1, TP.HCM",dist:3.3,time:"12 phút đi xe (GrabCar/XanhSM ~55.000đ)",hours:"06:00 - 19:00",space:"Biểu tượng lịch sử Sài Gòn từ 1912 với hàng trăm sạp đặc sản",park:"Gửi ô tô tại bãi xe đường Lê Lợi / Phan Chu Trinh sát chợ",price:"100.000 - 650.000đ/kg",minP:100000,desc:"Mua gì: Khô cá dứa 1 nắng Cần Giờ, khô cá lóc, mực một nắng, cơm cháy chà bông, hạt đười ươi, hạt é, bánh tét lá cẩm."},
      {id:86,tab:"tab4",name:"Cửa Hàng Đặc Sản Nắng Gió (Mủ Trôm & Khô 1 Nắng)",cat:"Mua Đặc Sản Làm Quà",stars:4.5,addr:"1/2 Chiến Lược, P. Bình Trị Đông, Quận Bình Tân, TP.HCM",dist:5.5,time:"20 phút đi xe (Taxi ~85.000đ hoặc Ship tận nơi 30k)",hours:"08:00 - 20:00",space:"Cửa hàng chuyên đóng gói hút chân không tiêu chuẩn đi xa",park:"Đỗ ô tô thoải mái trước cửa hàng",price:"150.000 - 550.000đ/gói",minP:150000,desc:"Mua gì: Bò khô một nắng, nai một nắng hút chân không (bảo quản 6 tháng) và mủ trôm thiên nhiên thanh nhiệt làm quà sức khỏe."}
    ];

    // STATE MANAGEMENT
    let currentTab = "tab1";
    let currentChip = "ALL";
    let searchQuery = "";
    let currentSort = "dist-asc";

    // INITIALIZE APP
    document.addEventListener("DOMContentLoaded", () => {
      updateTabCounts();
      renderChips();
      renderView();
    });

    function updateTabCounts() {
      ["tab1", "tab2", "tab3", "tab4"].forEach(t => {
        const count = DATA.filter(item => item.tab === t).length;
        const el = document.getElementById(`count-${t}`);
        if (el) el.textContent = count;
      });
      document.getElementById("totalItemsStat").textContent = `${DATA.length} Quán & Món Đặc Sản`;
    }

    function switchTab(tabId) {
      currentTab = tabId;
      currentChip = "ALL";
      document.querySelectorAll(".tab-btn").forEach(btn => {
        btn.classList.toggle("active", btn.getAttribute("data-tab") === tabId);
      });
      renderChips();
      renderView();
    }

    function renderChips() {
      const container = document.getElementById("filterChips");
      const tabItems = DATA.filter(item => item.tab === currentTab);
      const categories = ["ALL", ...new Set(tabItems.map(i => i.cat))];

      container.innerHTML = categories.map(cat => {
        const label = cat === "ALL" ? "Tất cả danh mục" : cat;
        const activeClass = currentChip === cat ? "active" : "";
        const count = cat === "ALL" ? tabItems.length : tabItems.filter(i => i.cat === cat).length;
        return `<button class="chip ${activeClass}" onclick="selectChip('${cat}')">${label} (${count})</button>`;
      }).join("");
    }

    function selectChip(cat) {
      currentChip = cat;
      renderChips();
      renderView();
    }

    function handleSearch() {
      const input = document.getElementById("searchInput");
      searchQuery = input.value.trim().toLowerCase();
      document.getElementById("clearSearchBtn").style.display = searchQuery ? "block" : "none";
      renderView();
    }

    function clearSearch() {
      const input = document.getElementById("searchInput");
      input.value = "";
      searchQuery = "";
      document.getElementById("clearSearchBtn").style.display = "none";
      renderView();
    }

    function handleSortChange() {
      currentSort = document.getElementById("sortSelect").value;
      updateSortArrows();
      renderView();
    }

    function sortByColumn(col) {
      if (col === "dist") {
        currentSort = currentSort === "dist-asc" ? "dist-desc" : "dist-asc";
      } else if (col === "stars") {
        currentSort = currentSort === "stars-desc" ? "stars-asc" : "stars-desc";
      } else if (col === "price") {
        currentSort = currentSort === "price-asc" ? "price-desc" : "price-asc";
      } else if (col === "name") {
        currentSort = currentSort === "name-asc" ? "name-desc" : "name-asc";
      }
      const select = document.getElementById("sortSelect");
      if ([...select.options].some(o => o.value === currentSort)) {
        select.value = currentSort;
      }
      updateSortArrows();
      renderView();
    }

    function updateSortArrows() {
      ["name", "stars", "dist", "price"].forEach(c => {
        const el = document.getElementById(`arrow-${c}`);
        if (el) el.textContent = "";
      });
      const [col, dir] = currentSort.split("-");
      const target = document.getElementById(`arrow-${col}`);
      if (target) {
        target.textContent = dir === "asc" ? "▲" : "▼";
      }
    }

    function toggleParkingBanner() {
      const banner = document.getElementById("parkingBanner");
      banner.classList.toggle("visible");
    }

    function buildMapsUrl(item) {
      const origin = encodeURIComponent("384 Lý Thái Tổ, Quận 10, TP.HCM");
      const dest = encodeURIComponent(`${item.name}, ${item.addr}`);
      return `https://www.google.com/maps/dir/?api=1&origin=${origin}&destination=${dest}&travelmode=driving`;
    }

    function getFilteredAndSortedData() {
      let list = DATA.filter(item => item.tab === currentTab);

      if (currentChip !== "ALL") {
        list = list.filter(item => item.cat === currentChip);
      }

      if (searchQuery) {
        list = list.filter(item =>
          item.name.toLowerCase().includes(searchQuery) ||
          item.cat.toLowerCase().includes(searchQuery) ||
          item.addr.toLowerCase().includes(searchQuery) ||
          item.park.toLowerCase().includes(searchQuery) ||
          item.desc.toLowerCase().includes(searchQuery)
        );
      }

      list.sort((a, b) => {
        switch (currentSort) {
          case "dist-asc": return a.dist - b.dist;
          case "dist-desc": return b.dist - a.dist;
          case "stars-desc": return b.stars - a.stars;
          case "stars-asc": return a.stars - b.stars;
          case "price-asc": return a.minP - b.minP;
          case "price-desc": return b.minP - a.minP;
          case "name-asc": return a.name.localeCompare(b.name, "vi");
          case "name-desc": return b.name.localeCompare(a.name, "vi");
          default: return 0;
        }
      });

      return list;
    }

    function renderView() {
      const list = getFilteredAndSortedData();
      const tbody = document.getElementById("tableBody");
      const cardsContainer = document.getElementById("cardsContainer");
      const countText = document.getElementById("resultsCountText");

      countText.textContent = `Hiển thị ${list.length} kết quả phù hợp (Điểm mốc: 384 Lý Thái Tổ, Phường Vườn Lài)`;

      if (list.length === 0) {
        const emptyHtml = `<tr><td colspan="8" style="text-align:center; padding:32px; font-weight:700; color:#475569;">Không tìm thấy quán hoặc món ăn nào khớp với từ khóa. Vui lòng thử từ khóa khác hoặc bấm "Tất cả danh mục".</td></tr>`;
        tbody.innerHTML = emptyHtml;
        cardsContainer.innerHTML = `<div class="food-card" style="text-align:center; font-weight:700;">Không tìm thấy kết quả phù hợp.</div>`;
        return;
      }

      // Render Table Rows
      tbody.innerHTML = list.map(item => {
        const mapUrl = buildMapsUrl(item);
        return `
          <tr>
            <td>
              <span class="cat-badge">${item.cat}</span>
              <span class="item-name">${item.name}</span>
            </td>
            <td>
              <span class="star-badge">★ ${item.stars.toFixed(1)}</span>
            </td>
            <td>
              <div style="font-weight:700; color:#0f172a;">${item.addr}</div>
            </td>
            <td>
              <span class="dist-badge">${item.dist} km</span>
              <div style="font-size:0.82rem; color:#475569; font-weight:600;">⏱ ${item.time}</div>
            </td>
            <td>
              <div style="font-weight:700; color:#0f172a;">🕒 ${item.hours}</div>
            </td>
            <td>
              <div style="font-size:0.85rem; margin-bottom:6px;"><strong>Không gian:</strong> ${item.space}</div>
              <div class="parking-info">🅿️ ${item.park}</div>
            </td>
            <td>
              <span class="price-tag">${item.price}</span>
            </td>
            <td>
              <div class="desc-text">${item.desc}</div>
              <a href="${mapUrl}" target="_blank" rel="noopener noreferrer" class="map-btn">🗺️ Chỉ đường Maps</a>
            </td>
          </tr>
        `;
      }).join("");

      // Render Mobile Cards
      cardsContainer.innerHTML = list.map(item => {
        const mapUrl = buildMapsUrl(item);
        return `
          <article class="food-card">
            <div class="card-header">
              <div>
                <span class="cat-badge">${item.cat}</span>
                <span class="item-name">${item.name}</span>
              </div>
              <span class="star-badge">★ ${item.stars.toFixed(1)}</span>
            </div>
            <div style="font-size:0.9rem; font-weight:700; color:#0f172a;">📍 ${item.addr}</div>
            <div class="card-meta-grid">
              <div class="card-meta-item">
                <strong>Khoảng cách từ 384 LTT</strong>
                <span style="color:#1e40af; font-weight:800;">${item.dist} km (${item.time})</span>
              </div>
              <div class="card-meta-item">
                <strong>Giờ hoạt động</strong>
                <span style="font-weight:700;">${item.hours}</span>
              </div>
              <div class="card-meta-item">
                <strong>Mức giá tham khảo</strong>
                <span style="color:#b91c1c; font-weight:800;">${item.price}</span>
              </div>
              <div class="card-meta-item">
                <strong>Không gian</strong>
                <span>${item.space}</span>
              </div>
            </div>
            <div class="parking-info">🅿️ <strong>Đỗ ô tô:</strong> ${item.park}</div>
            <div class="desc-text"><strong>Điểm nhấn:</strong> ${item.desc}</div>
            <a href="${mapUrl}" target="_blank" rel="noopener noreferrer" class="map-btn" style="width:100%;">🗺️ Mở Google Maps Chỉ Đường Từ 384 Lý Thái Tổ</a>
          </article>
        `;
      }).join("");
    }
  </script>
