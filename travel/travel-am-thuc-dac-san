      {id:81,tab:"tab4",name:"Khu Đặc Sản Siêu Thị Sài Gòn (Satramart)",cat:"Mua Đặc Sản Làm Quà",stars:4.5,addr:"436 Đường 3 Tháng 2, P. Hòa Hưng (P.12, Q.10 cũ), TP.HCM",dist:0.8,time:"3 phút đi xe (GrabCar ~32.000đ)",hours:"07:30 - 22:00",space:"Siêu thị lớn máy lạnh, hàng hóa niêm yết giá chuẩn 100%",park:"Có bãi đỗ xe ô tô lớn ngay trong khuôn viên (10k/tiếng)",price:"45.000 - 400.000đ/sản phẩm",minP:45000,desc:"Mua gì: Cơm cháy chà bông Sài Gòn, bánh pía sầu riêng Tân Huệ Viên, bánh dừa nướng, hạt điều rang muối, trà & cà phê."},
      {id:82,tab:"tab4",name:"Bánh Pía Sầu Riêng Tân Huệ Viên / Hưng Thành",cat:"Mua Đặc Sản Làm Quà",stars:4.7,addr:"Phân phối chính hãng tại Chợ An Đông (Q.5) & Trục Hồng Bàng - Nguyễn Tri Phương",dist:1.2,time:"5 phút đi xe (GrabCar ~35.000đ)",hours:"07:00 - 21:00",space:"Cửa hàng & đại lý phân phối đặc sản miền Nam",park:"Dừng đỗ ô tô trước cửa hàng dễ dàng",price:"65.000 - 160.000đ/túi",minP:65000,desc:"Mua gì: Bánh pía sầu riêng trứng muối, bánh pía kim sa (trọng lượng 250g - 500g, hạn dùng 30-40 ngày, bao bì từng chiếc rất tiện mang về)."},
