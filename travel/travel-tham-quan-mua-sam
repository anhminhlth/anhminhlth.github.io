        { key: "price", label: "Chi Phí / Giá Vé", type: "number" },
        { key: "vibe", label: "Trải Nghiệm (20-40 Tuổi) & Đỗ Xe Đêm", type: "string" },
        { key: "dist", label: "Từ 384 Lý Thái Tổ", type: "number" },
        { key: "action", label: "Chỉ Đường", type: "none" }
      ],
      tab4: [
        { key: "cat", label: "Nhóm Danh Mục", type: "string" },
        { key: "name", label: "Phương Tiện / Lộ Trình / Bãi Đỗ Ô Tô", type: "string" },
        { key: "spec", label: "Thông Số / Khoảng Cách & Giờ Hoạt Động", type: "string" },
        { key: "price", label: "Bảng Giá & Chi Phí Cụ Thể (VNĐ)", type: "number" },
        { key: "note", label: "Chi Tiết Vận Hành, Thủ Tục & Lưu Ý Thực Tế", type: "string" },
        { key: "action", label: "Bản Đồ", type: "none" }
      ]
    };

    /* Helper: Build Google Maps Directions URL from 384 Lý Thái Tổ */
    function buildMapUrl(destQuery) {
      const origin = encodeURIComponent(ORIGIN_QUERY);
      const dest = encodeURIComponent(destQuery + ", TP.HCM");
      return `https://www.google.com/maps/dir/?api=1&origin=${origin}&destination=${dest}&travelmode=driving`;
    }

    /* Helper: Badge Color Assignment */
    function getBadgeClass(text) {
      if (!text) return "badge-blue";
      const t = text.toLowerCase();
      if (t.includes("bờ sông") || t.includes("công cộng") || t.includes("sông")) return "badge-blue";
      if (t.includes("nghệ thuật") || t.includes("rooftop") || t.includes("thuê xe")) return "badge-purple";
      if (t.includes("kiến trúc") || t.includes("lộ trình") || t.includes("phố đi bộ")) return "badge-amber";
      if (t.includes("bãi xe") || t.includes("văn hóa") || t.includes("acoustic")) return "badge-green";
      return "badge-rose";
    }

    /* Populate Category Dropdown Dynamically */
    function updateCategoryDropdown() {
      const select = document.getElementById("categoryFilter");
      let rawData = DB[currentTab];
      if (currentTab === "tab4" && currentSubTab4 !== "all") {
        rawData = rawData.filter(item => item.sub === currentSubTab4);
      }

      const categories = new Set();
      rawData.forEach(item => {
        if (item.cat) categories.add(item.cat);
        else if (currentTab === "tab2") {
          if (item.fee === 0) categories.add("Miễn phí gửi ô tô");
          else if (item.fee <= 30000) categories.add("Phí gửi xe <= 30.000đ");
          else categories.add("TTTM Trung tâm Q.1");
        }
      });

      select.innerHTML = `<option value="ALL">Tất cả phân loại (${rawData.length})</option>`;
      Array.from(categories).forEach(c => {
        const opt = document.createElement("option");
        opt.value = c;
        opt.textContent = c;
        select.appendChild(opt);
      });
      select.value = selectedCategory;
      if (select.value !== selectedCategory) {
        selectedCategory = "ALL";
        select.value = "ALL";
      }
    }

    /* Filter & Sort Data */
    function getProcessedData() {
      let list = [...DB[currentTab]];

      if (currentTab === "tab4" && currentSubTab4 !== "all") {
        list = list.filter(item => item.sub === currentSubTab4);
      }

      if (selectedCategory !== "ALL") {
        list = list.filter(item => {
          if (item.cat) return item.cat === selectedCategory;
          if (currentTab === "tab2") {
            if (selectedCategory === "Miễn phí gửi ô tô") return item.fee === 0;
            if (selectedCategory === "Phí gửi xe <= 30.000đ") return item.fee > 0 && item.fee <= 30000;
            if (selectedCategory === "TTTM Trung tâm Q.1") return item.fee > 30000;
          }
          return true;
        });
      }

      if (searchQuery.trim() !== "") {
        const q = searchQuery.toLowerCase().trim();
        list = list.filter(item => {
          return Object.values(item).some(val =>
            String(val).toLowerCase().includes(q)
          );
        });
      }

      if (sortKey) {
        const colDef = COLUMNS[currentTab].find(c => c.key === sortKey);
        const isNum = colDef && colDef.type === "number";

        list.sort((a, b) => {
          let valA = a[sortKey];
          let valB = b[sortKey];

          if (isNum) {
            valA = Number(valA) || 0;
            valB = Number(valB) || 0;
            return sortDir === "asc" ? valA - valB : valB - valA;
          } else {
            valA = String(valA || "").toLowerCase();
            valB = String(valB || "").toLowerCase();
            return sortDir === "asc"
              ? valA.localeCompare(valB, "vi")
              : valB.localeCompare(valA, "vi");
          }
        });
      }

      return list;
    }

    /* Render Table HTML */
    function renderTable() {
      const wrapper = document.getElementById("tableWrapper");
      const cols = COLUMNS[currentTab];
      const data = getProcessedData();

      document.getElementById("resultStats").textContent = `Đang hiển thị: ${data.length} mục`;

      if (data.length === 0) {
        wrapper.innerHTML = `
          <div class="table-container">
            <div class="empty-state">
              <p><strong>Không tìm thấy kết quả phù hợp với từ khóa hoặc bộ lọc hiện tại.</strong></p>
              <p style="margin-top:6px;">Hãy nhấn nút "Đặt lại" hoặc thử từ khóa khác (ví dụ: Waterbus, Landmark 81, Haidilao, Lý Thái Tổ).</p>
            </div>
          </div>`;
        return;
      }

      let theadHtml = `<thead><tr>`;
      cols.forEach(col => {
        if (col.type === "none") {
          theadHtml += `<th class="no-sort">${col.label}</th>`;
        } else {
          let sortClass = "";
          let arrow = "&#8597;";
          if (sortKey === col.key) {
            sortClass = sortDir === "asc" ? "sorted-asc" : "sorted-desc";
            arrow = sortDir === "asc" ? "&#9650;" : "&#9660;";
          }
          theadHtml += `<th class="${sortClass}" data-sort-key="${col.key}">${col.label}<span class="sort-indicator">${arrow}</span></th>`;
        }
      });
      theadHtml += `</tr></thead>`;

      let tbodyHtml = `<tbody>`;
      data.forEach(row => {
        const mapUrl = buildMapUrl(row.map || row.name);
        if (currentTab === "tab1") {
          tbodyHtml += `
            <tr>
              <td data-label="${cols[0].label}">
                <span class="place-name">${row.name}</span>
                <span class="place-addr">&#128205; ${row.addr}</span>
              </td>
              <td data-label="${cols[1].label}">
                <span class="badge ${getBadgeClass(row.cat)}">${row.cat}</span>
              </td>
              <td data-label="${cols[2].label}">${row.hours}</td>
              <td data-label="${cols[3].label}">
                <span class="price-text">${row.priceTxt}</span>
              </td>
              <td data-label="${cols[4].label}">${row.parking}</td>
              <td data-label="${cols[5].label}">
                <span class="dist-pill">${row.dist} km</span>
                <span class="place-addr">&#9201; ${row.time}</span>
              </td>
              <td data-label="${cols[6].label}">
                <a href="${mapUrl}" target="_blank" rel="noopener noreferrer" class="map-btn">&#128506; Chỉ đường</a>
              </td>
            </tr>`;
        } else if (currentTab === "tab2") {
          tbodyHtml += `
            <tr>
              <td data-label="${cols[0].label}">
                <span class="place-name">${row.name}</span>
                <span class="place-addr">&#128205; ${row.addr}</span>
              </td>
              <td data-label="${cols[1].label}">
                <span class="badge badge-blue">Hầm &amp; Bãi Ô Tô</span>
                <div style="margin-top:3px;">${row.scale}</div>
              </td>
              <td data-label="${cols[2].label}">
                <span class="price-text">${row.feeTxt}</span>
                <span class="place-addr">&#128338; Mở cửa: ${row.hours}</span>
              </td>
              <td data-label="${cols[3].label}">
                <div class="brand-list"><strong>Nổi bật:</strong> ${row.brands}</div>
              </td>
              <td data-label="${cols[4].label}">
                <span class="dist-pill">${row.dist} km</span>
                <span class="place-addr">&#9201; ${row.time}</span>
              </td>
              <td data-label="${cols[5].label}">
                <a href="${mapUrl}" target="_blank" rel="noopener noreferrer" class="map-btn">&#128506; Chỉ đường</a>
              </td>
            </tr>`;
        } else if (currentTab === "tab3") {
          tbodyHtml += `
            <tr>
              <td data-label="${cols[0].label}">
                <span class="place-name">${row.name}</span>
                <span class="place-addr">&#128205; ${row.addr}</span>
              </td>
              <td data-label="${cols[1].label}">
                <span class="badge ${getBadgeClass(row.cat)}">${row.cat}</span>
              </td>
              <td data-label="${cols[2].label}">
                <strong style="color:var(--brand-primary);">${row.hours}</strong>
              </td>
              <td data-label="${cols[3].label}">
                <span class="price-text">${row.priceTxt}</span>
              </td>
              <td data-label="${cols[4].label}">${row.vibe}</td>
              <td data-label="${cols[5].label}">
                <span class="dist-pill">${row.dist} km</span>
                <span class="place-addr">&#9201; ${row.time}</span>
              </td>
              <td data-label="${cols[6].label}">
                <a href="${mapUrl}" target="_blank" rel="noopener noreferrer" class="map-btn">&#128506; Chỉ đường</a>
              </td>
            </tr>`;
        } else if (currentTab === "tab4") {
          tbodyHtml += `
            <tr>
              <td data-label="${cols[0].label}">
                <span class="badge ${getBadgeClass(row.cat)}">${row.cat}</span>
              </td>
              <td data-label="${cols[1].label}">
                <span class="place-name">${row.name}</span>
              </td>
              <td data-label="${cols[2].label}">${row.spec}</td>
              <td data-label="${cols[3].label}">
                <span class="price-text">${row.priceTxt}</span>
              </td>
              <td data-label="${cols[4].label}">${row.note}</td>
              <td data-label="${cols[5].label}">
                <a href="${mapUrl}" target="_blank" rel="noopener noreferrer" class="map-btn">&#128506; Lộ trình</a>
              </td>
            </tr>`;
        }
      });
      tbodyHtml += `</tbody>`;

      wrapper.innerHTML = `<div class="table-container"><table class="data-table">${theadHtml}${tbodyHtml}</table></div>`;

      /* Bind Click-to-Sort Events on Table Headers */
      wrapper.querySelectorAll("th[data-sort-key]").forEach(th => {
        th.addEventListener("click", () => {
          const clickedKey = th.getAttribute("data-sort-key");
          if (sortKey === clickedKey) {
            sortDir = sortDir === "asc" ? "desc" : "asc";
          } else {
            sortKey = clickedKey;
            sortDir = "asc";
          }
          renderTable();
        });
      });
    }

    /* Event Listeners Initialization */
    document.addEventListener("DOMContentLoaded", () => {
      // Main Tab Switching
      document.querySelectorAll("#mainTabs .tab-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          document.querySelectorAll("#mainTabs .tab-btn").forEach(b => b.classList.remove("active"));
          btn.classList.add("active");
          currentTab = btn.getAttribute("data-tab");
          selectedCategory = "ALL";
          sortKey = null;
          sortDir = "asc";
          document.getElementById("mobileSortSelect").value = "default";

          const subNav = document.getElementById("tab4SubNav");
          subNav.style.display = currentTab === "tab4" ? "flex" : "none";

          updateCategoryDropdown();
          renderTable();
        });
      });

      // Sub-tab Switching for Tab 4
      document.querySelectorAll("#tab4SubNav .subtab-btn").forEach(sbtn => {
        sbtn.addEventListener("click", () => {
          document.querySelectorAll("#tab4SubNav .subtab-btn").forEach(b => b.classList.remove("active"));
          sbtn.classList.add("active");
          currentSubTab4 = sbtn.getAttribute("data-subtab");
          selectedCategory = "ALL";
          updateCategoryDropdown();
          renderTable();
        });
      });

      // Live Search Input
      document.getElementById("searchInput").addEventListener("input", e => {
        searchQuery = e.target.value;
        renderTable();
      });

      // Category Dropdown Filter
      document.getElementById("categoryFilter").addEventListener("change", e => {
        selectedCategory = e.target.value;
        renderTable();
      });

      // Mobile / Quick Sort Dropdown
      document.getElementById("mobileSortSelect").addEventListener("change", e => {
        const val = e.target.value;
        if (val === "default") {
          sortKey = null;
        } else if (val === "dist-asc") {
          sortKey = currentTab === "tab4" ? "price" : "dist";
          sortDir = "asc";
        } else if (val === "dist-desc") {
          sortKey = currentTab === "tab4" ? "price" : "dist";
          sortDir = "desc";
        } else if (val === "price-asc") {
          sortKey = currentTab === "tab2" ? "fee" : "price";
          sortDir = "asc";
        } else if (val === "price-desc") {
          sortKey = currentTab === "tab2" ? "fee" : "price";
          sortDir = "desc";
        } else if (val === "name-asc") {
          sortKey = "name";
          sortDir = "asc";
        }
        renderTable();
      });

      // Reset Button
      document.getElementById("resetBtn").addEventListener("click", () => {
        searchQuery = "";
        selectedCategory = "ALL";
        sortKey = null;
        sortDir = "asc";
        document.getElementById("searchInput").value = "";
        document.getElementById("mobileSortSelect").value = "default";
        if (currentTab === "tab4") {
          currentSubTab4 = "all";
          document.querySelectorAll("#tab4SubNav .subtab-btn").forEach(b => b.classList.remove("active"));
          document.querySelector('#tab4SubNav .subtab-btn[data-subtab="all"]').classList.add("active");
        }
        updateCategoryDropdown();
        renderTable();
      });

      // Initial Render
      updateCategoryDropdown();
      renderTable();
    });
  </script>
</body>
</html>
