<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <title>Địa điểm Tham quan &amp; Mua sắm</title>
  <style>
    :root {
      --bg-page: #f8fafc;
      --bg-surface: #ffffff;
      --bg-subtle: #f1f5f9;
      --bg-hover: #eff6ff;
      --text-primary: #0f172a;
      --text-secondary: #334155;
      --text-muted: #64748b;
      --brand-primary: #1d4ed8;
      --brand-secondary: #0284c7;
      --brand-accent: #0f766e;
      --border-color: #e2e8f0;
      --border-strong: #cbd5e1;
      --badge-blue-bg: #dbeafe;
      --badge-blue-text: #1e40af;
      --badge-green-bg: #dcfce7;
      --badge-green-text: #166534;
      --badge-amber-bg: #fef3c7;
      --badge-amber-text: #92400e;
      --badge-purple-bg: #f3e8ff;
      --badge-purple-text: #6b21a8;
      --badge-rose-bg: #ffe4e6;
      --badge-rose-text: #9f1239;
      --shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.06), 0 1px 2px rgba(15, 23, 42, 0.04);
      --shadow-md: 0 4px 12px rgba(15, 23, 42, 0.08);
      --radius-md: 10px;
      --radius-lg: 14px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      background-color: var(--bg-page);
      color: var(--text-primary);
      line-height: 1.55;
      font-size: 14.5px;
      -webkit-font-smoothing: antialiased;
    }

    /* Header & Hero Banner */
    .app-header {
      background: linear-gradient(135deg, #ffffff 0%, #f0f7ff 100%);
      border-bottom: 1px solid var(--border-color);
      padding: 20px 16px;
      box-shadow: var(--shadow-sm);
    }

    .container {
      max-width: 1360px;
      margin: 0 auto;
    }

    .header-top {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: flex-start;
      gap: 14px;
    }

    .title-group h1 {
      font-size: 1.55rem;
      font-weight: 800;
      color: var(--text-primary);
      letter-spacing: -0.02em;
      margin-bottom: 4px;
    }

    .title-group p {
      color: var(--text-secondary);
      font-size: 0.92rem;
    }

    .origin-badge {
      background-color: var(--bg-surface);
      border: 1.5px solid #bfdbfe;
      border-radius: var(--radius-md);
      padding: 10px 14px;
      display: flex;
      flex-direction: column;
      gap: 3px;
      box-shadow: var(--shadow-sm);
    }

    .origin-badge .label {
      font-size: 0.72rem;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--brand-primary);
      letter-spacing: 0.04em;
    }

    .origin-badge .val {
      font-size: 0.9rem;
      font-weight: 700;
      color: var(--text-primary);
    }

    .origin-badge .sub {
      font-size: 0.78rem;
      color: var(--text-muted);
    }

    /* Quick KPI Bar */
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 10px;
      margin-top: 16px;
    }

    .kpi-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 10px 14px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .kpi-card .kpi-info span {
      display: block;
      font-size: 0.76rem;
      color: var(--text-muted);
      font-weight: 600;
    }

    .kpi-card .kpi-info strong {
      font-size: 1.05rem;
      color: var(--text-primary);
      font-weight: 800;
    }

    .kpi-tag {
      font-size: 0.75rem;
      font-weight: 700;
      padding: 4px 8px;
      border-radius: 6px;
      background: var(--badge-blue-bg);
      color: var(--badge-blue-text);
    }

    /* Navigation Tabs */
    .tabs-wrapper {
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border-color);
      position: sticky;
      top: 0;
      z-index: 50;
      box-shadow: 0 2px 6px rgba(15, 23, 42, 0.04);
    }

    .tabs-nav {
      display: flex;
      overflow-x: auto;
      gap: 6px;
      padding: 10px 16px;
      scrollbar-width: thin;
    }

    .tab-btn {
      appearance: none;
      border: 1px solid var(--border-color);
      background: var(--bg-subtle);
      color: var(--text-secondary);
      font-weight: 600;
      font-size: 0.88rem;
      padding: 10px 16px;
      border-radius: 8px;
      cursor: pointer;
      white-space: nowrap;
      transition: all 0.18s ease;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .tab-btn:hover {
      background: var(--bg-hover);
      color: var(--brand-primary);
      border-color: #93c5fd;
    }

    .tab-btn.active {
      background: var(--brand-primary);
      color: #ffffff;
      border-color: var(--brand-primary);
      box-shadow: 0 2px 6px rgba(29, 78, 216, 0.25);
    }

    .tab-count {
      background: rgba(15, 23, 42, 0.1);
      color: inherit;
      font-size: 0.74rem;
      padding: 2px 7px;
      border-radius: 999px;
      font-weight: 700;
    }

    .tab-btn.active .tab-count {
      background: rgba(255, 255, 255, 0.22);
      color: #ffffff;
    }

    /* Filter & Search Controls */
    .controls-bar {
      background: var(--bg-surface);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      padding: 14px 16px;
      margin: 18px 0;
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: center;
      justify-content: space-between;
      box-shadow: var(--shadow-sm);
    }

    .search-group {
      flex: 1 1 280px;
      position: relative;
    }

    .search-input {
      width: 100%;
      padding: 10px 14px 10px 36px;
      border: 1px solid var(--border-strong);
      border-radius: 8px;
      font-size: 0.9rem;
      color: var(--text-primary);
      background-color: var(--bg-surface);
      transition: border-color 0.15s, box-shadow 0.15s;
    }

    .search-input:focus {
      outline: none;
      border-color: var(--brand-primary);
      box-shadow: 0 0 0 3px rgba(29, 78, 216, 0.12);
    }

    .search-icon {
      position: absolute;
      left: 11px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
      font-size: 0.95rem;
      pointer-events: none;
    }

    .filter-group {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      align-items: center;
    }

    .filter-select {
      padding: 9px 12px;
      border: 1px solid var(--border-strong);
      border-radius: 8px;
      background-color: var(--bg-surface);
      color: var(--text-primary);
      font-size: 0.86rem;
      font-weight: 500;
      cursor: pointer;
    }

    .filter-select:focus {
      outline: none;
      border-color: var(--brand-primary);
    }

    .reset-btn {
      padding: 9px 13px;
      border: 1px solid var(--border-strong);
      border-radius: 8px;
      background: var(--bg-subtle);
      color: var(--text-secondary);
      font-size: 0.84rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.15s, color 0.15s;
    }

    .reset-btn:hover {
      background: #e2e8f0;
      color: var(--text-primary);
    }

    /* Sub-navigation for Tab 4 */
    .subtab-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 14px;
    }

    .subtab-btn {
      padding: 8px 14px;
      border-radius: 8px;
      border: 1px solid var(--border-strong);
      background: var(--bg-surface);
      color: var(--text-secondary);
      font-weight: 600;
      font-size: 0.84rem;
      cursor: pointer;
      transition: all 0.15s;
    }

    .subtab-btn:hover {
      background: var(--bg-hover);
      color: var(--brand-primary);
      border-color: #93c5fd;
    }

    .subtab-btn.active {
      background: #0f172a;
      color: #ffffff;
      border-color: #0f172a;
    }

    /* Section Info Banner */
    .section-banner {
      background: #f0f9ff;
      border-left: 4px solid var(--brand-secondary);
      padding: 11px 15px;
      border-radius: 6px;
      margin-bottom: 14px;
      font-size: 0.86rem;
      color: var(--text-secondary);
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
    }

    /* Table Styling - Anti-clash Hover Guarantee */
    .table-container {
      background: var(--bg-surface);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-sm);
      overflow-x: auto;
      margin-bottom: 28px;
    }

    table.data-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    table.data-table thead th {
      background-color: #f1f5f9;
      color: var(--text-primary);
      font-weight: 700;
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      padding: 13px 14px;
      border-bottom: 2px solid var(--border-strong);
      cursor: pointer;
      user-select: none;
      white-space: nowrap;
      transition: background-color 0.15s, color 0.15s;
    }

    table.data-table thead th:hover {
      background-color: #e2e8f0;
      color: var(--brand-primary);
    }

    table.data-table thead th.no-sort {
      cursor: default;
    }

    table.data-table thead th.no-sort:hover {
      background-color: #f1f5f9;
      color: var(--text-primary);
    }

    .sort-indicator {
      display: inline-block;
      margin-left: 5px;
      font-size: 0.75rem;
      color: var(--text-muted);
    }

    th.sorted-asc .sort-indicator,
    th.sorted-desc .sort-indicator {
      color: var(--brand-primary);
      font-weight: 900;
    }

    table.data-table tbody tr {
      border-bottom: 1px solid var(--border-color);
      background-color: var(--bg-surface);
      transition: background-color 0.12s ease;
    }

    table.data-table tbody tr:nth-child(even) {
      background-color: #fafbfc;
    }

    /* High-contrast hover state preventing any text/background clash */
    table.data-table tbody tr:hover {
      background-color: var(--bg-hover) !important;
      color: var(--text-primary) !important;
    }

    table.data-table tbody td {
      padding: 13px 14px;
      vertical-align: top;
      color: var(--text-secondary);
      font-size: 0.88rem;
    }

    /* Typography & Badges inside Table Cells */
    .place-name {
      font-weight: 700;
      color: var(--text-primary);
      font-size: 0.94rem;
      margin-bottom: 3px;
      display: block;
    }

    .place-addr {
      font-size: 0.8rem;
      color: var(--text-muted);
      display: block;
    }

    .badge {
      display: inline-block;
      padding: 3px 8px;
      border-radius: 6px;
      font-size: 0.74rem;
      font-weight: 700;
      line-height: 1.3;
      margin-right: 4px;
      margin-bottom: 4px;
    }

    .badge-blue { background: var(--badge-blue-bg); color: var(--badge-blue-text); }
    .badge-green { background: var(--badge-green-bg); color: var(--badge-green-text); }
    .badge-amber { background: var(--badge-amber-bg); color: var(--badge-amber-text); }
    .badge-purple { background: var(--badge-purple-bg); color: var(--badge-purple-text); }
    .badge-rose { background: var(--badge-rose-bg); color: var(--badge-rose-text); }

    .price-text {
      font-weight: 700;
      color: #0f766e;
      display: block;
    }

    .dist-pill {
      font-weight: 700;
      color: var(--brand-primary);
      background: #eff6ff;
      border: 1px solid #bfdbfe;
      padding: 2px 7px;
      border-radius: 6px;
      display: inline-block;
      font-size: 0.8rem;
      margin-bottom: 3px;
    }

    .brand-list {
      font-size: 0.82rem;
      color: var(--text-secondary);
      line-height: 1.45;
    }

    .brand-list strong {
      color: var(--text-primary);
    }

    /* Action Button: Direct Google Maps Routing from 384 Lý Thái Tổ */
    .map-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      background-color: #ffffff;
      color: var(--brand-primary);
      border: 1.5px solid var(--brand-primary);
      padding: 6px 11px;
      border-radius: 7px;
      font-size: 0.78rem;
      font-weight: 700;
      text-decoration: none;
      white-space: nowrap;
      transition: all 0.15s ease;
    }

    .map-btn:hover {
      background-color: var(--brand-primary);
      color: #ffffff !important;
      box-shadow: 0 2px 6px rgba(29, 78, 216, 0.25);
    }

    .empty-state {
      text-align: center;
      padding: 40px 20px;
      color: var(--text-muted);
      font-size: 0.95rem;
    }

    .main-wrap {
      padding: 0 16px 40px;
    }

    .app-footer {
      border-top: 1px solid var(--border-color);
      background: var(--bg-surface);
      padding: 18px 16px;
      text-align: center;
      font-size: 0.82rem;
      color: var(--text-muted);
    }

    /* Responsive Card View on Mobile (<620px) */
    @media screen and (max-width: 620px) {
      .title-group h1 {
        font-size: 1.28rem;
      }

      .controls-bar {
        flex-direction: column;
        align-items: stretch;
      }

      .filter-group {
        width: 100%;
      }

      .filter-select, .reset-btn {
        flex: 1 1 auto;
      }

      .table-container {
        border: none;
        background: transparent;
        box-shadow: none;
        overflow-x: visible;
      }

      table.data-table,
      table.data-table tbody,
      table.data-table tr,
      table.data-table td {
        display: block;
        width: 100%;
      }

      /* Keep mobile sort selector visible while hiding wide desktop table header */
      table.data-table thead {
        display: none;
      }

      table.data-table tbody tr {
        background: var(--bg-surface);
        border: 1px solid var(--border-strong);
        border-radius: var(--radius-md);
        margin-bottom: 14px;
        padding: 12px;
        box-shadow: var(--shadow-sm);
      }

      table.data-table tbody tr:nth-child(even) {
        background: var(--bg-surface);
      }

      table.data-table tbody td {
        padding: 8px 4px;
        border-bottom: 1px dashed var(--border-color);
        display: flex;
        flex-direction: column;
        gap: 3px;
      }

      table.data-table tbody td:last-child {
        border-bottom: none;
        padding-top: 10px;
      }

      table.data-table tbody td::before {
        content: attr(data-label);
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--text-muted);
        letter-spacing: 0.03em;
      }

      .map-btn {
        width: 100%;
        padding: 9px 12px;
        font-size: 0.84rem;
      }
    }
  </style>
</head>
<body>

  <header class="app-header">
    <div class="container">
      <div class="header-top">
        <div class="title-group">
          <h1>Địa điểm Tham quan &amp; Mua sắm</h1>
          <p>Hệ thống dữ liệu Du lịch, Trung tâm thương mại, Giải trí đêm (&ge;22h) &amp; Cẩm nang di chuyển TP.HCM (Lứa tuổi 20–40)</p>
        </div>
        <div class="origin-badge">
          <span class="label">Điểm mốc xuất phát (Origin)</span>
          <span class="val">384 Lý Thái Tổ, Phường Vườn Lài</span>
          <span class="sub">Quận 10 cũ, TP.HCM &bull; Cách bãi ô tô 24/7 &lt;100m</span>
        </div>
      </div>

      <div class="kpi-grid">
        <div class="kpi-card">
          <div class="kpi-info">
            <span>Tổng điểm &amp; mục dữ liệu</span>
            <strong id="totalDataCount">92 mục</strong>
          </div>
          <span class="kpi-tag">Chuẩn 2025–2026</span>
        </div>
        <div class="kpi-card">
          <div class="kpi-info">
            <span>Metro Số 1 &amp; Waterbus</span>
            <strong>6.000đ – 20.000đ</strong>
          </div>
          <span class="kpi-tag">Vé ngày 40k</span>
        </div>
        <div class="kpi-card">
          <div class="kpi-info">
            <span>Taxi Điện / Công nghệ</span>
            <strong>Mở cửa 30.500đ/2km</strong>
          </div>
          <span class="kpi-tag">14.5k/km tiếp</span>
        </div>
        <div class="kpi-card">
          <div class="kpi-info">
            <span>Thuê Ô tô Tự lái (4h–24h)</span>
            <strong>Từ 380k – 2.400k</strong>
          </div>
          <span class="kpi-tag">VNeID + Bằng B</span>
        </div>
      </div>
    </div>
  </header>

  <div class="tabs-wrapper">
    <div class="container">
      <nav class="tabs-nav" id="mainTabs" role="tablist">
        <button class="tab-btn active" data-tab="tab1" role="tab">
          <span>1. Địa Điểm Du Lịch &amp; Check-in (20-40 tuổi)</span>
          <span class="tab-count" id="count-tab1">20</span>
        </button>
        <button class="tab-btn" data-tab="tab2" role="tab">
          <span>2. Trung Tâm Thương Mại &amp; Mua Sắm</span>
          <span class="tab-count" id="count-tab2">15</span>
        </button>
        <button class="tab-btn" data-tab="tab3" role="tab">
          <span>3. Vui Chơi Giải Trí &amp; Hoạt Động Đêm (&ge;22h)</span>
          <span class="tab-count" id="count-tab3">18</span>
        </button>
        <button class="tab-btn" data-tab="tab4" role="tab">
          <span>4. Cẩm Nang Di Chuyển, Lộ Trình &amp; Bãi Đỗ Xe</span>
          <span class="tab-count" id="count-tab4">39</span>
        </button>
      </nav>
    </div>
  </div>

  <main class="container main-wrap">
    <!-- Filter & Search Controls -->
    <div class="controls-bar">
      <div class="search-group">
        <span class="search-icon">&#128269;</span>
        <input type="text" id="searchInput" class="search-input" placeholder="Tìm tên địa điểm, thương hiệu (The Running Bean, 4P's...), đường, bãi đỗ xe..." />
      </div>
      <div class="filter-group">
        <select id="categoryFilter" class="filter-select" aria-label="Lọc theo phân loại">
          <option value="ALL">Tất cả phân loại</option>
        </select>
        <select id="mobileSortSelect" class="filter-select" aria-label="Sắp xếp nhanh">
          <option value="default">Sắp xếp: Mặc định</option>
          <option value="dist-asc">Khoảng cách: Gần &rarr; Xa</option>
          <option value="dist-desc">Khoảng cách: Xa &rarr; Gần</option>
          <option value="price-asc">Chi phí/Giá: Thấp &rarr; Cao</option>
          <option value="price-desc">Chi phí/Giá: Cao &rarr; Thấp</option>
          <option value="name-asc">Tên: A &rarr; Z</option>
        </select>
        <button id="resetBtn" class="reset-btn" type="button">Đặt lại</button>
      </div>
    </div>

    <!-- Sub-tabs only shown when Tab 4 is active -->
    <div id="tab4SubNav" class="subtab-bar" style="display: none;">
      <button class="subtab-btn active" data-subtab="all">Tất cả mục Di chuyển &amp; Bãi xe (39)</button>
      <button class="subtab-btn" data-subtab="modes">4A. Bảng Giá Phương Tiện &amp; Thuê Xe (12)</button>
      <button class="subtab-btn" data-subtab="routes">4B. Lộ Trình &amp; Chi Phí Từ 384 Lý Thái Tổ (12)</button>
      <button class="subtab-btn" data-subtab="parking">4C. Danh Sách Bãi Đỗ Ô Tô Quanh Điểm Mốc &amp; Trung Tâm (15)</button>
    </div>

    <div class="section-banner" id="sectionBanner">
      <span id="bannerText">Nhấn trực tiếp vào tiêu đề cột bất kỳ trên bảng để sắp xếp (Click-to-Sort) tăng/giảm dần.</span>
      <span id="resultStats" style="font-weight:700; color:var(--brand-primary);">Đang hiển thị: 20 mục</span>
    </div>

    <!-- Dynamic Table Container -->
    <div id="tableWrapper"></div>
  </main>

  <footer class="app-footer">
    <div class="container">
      <p><strong>Cẩm Nang Du Lịch, Mua Sắm, Giải Trí &amp; Giao Thông Đô Thị TP.HCM (2025–2026)</strong> &bull; Điểm mốc chuẩn: 384 Lý Thái Tổ, Phường Vườn Lài (Quận 10 cũ), TP.HCM.</p>
    </div>
  </footer>

  <script>
    const ORIGIN_QUERY = "384 Lý Thái Tổ, Phường 10, Quận 10, Thành phố Hồ Chí Minh";

    /* Compressed JSON Dataset (92 verified items across 4 tabs) */
