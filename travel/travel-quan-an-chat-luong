<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
  <title>Hệ Thống Tra Cứu Quán Ăn Chất Lượng & Nhà Hàng Lịch Sự - Mốc 384 Lý Thái Tổ</title>
  <style>
    :root {
      --bg-body: #f8fafc;
      --bg-card: #ffffff;
      --bg-header: #0f172a;
      --text-main: #0f172a;
      --text-muted: #475569;
      --text-light: #f8fafc;
      --primary: #1d4ed8;
      --primary-hover: #1e40af;
      --primary-soft: #eff6ff;
      --accent-amber: #d97706;
      --accent-amber-bg: #fef3c7;
      --accent-green: #059669;
      --accent-green-bg: #d1fae5;
      --accent-purple: #7c3aed;
      --accent-purple-bg: #ede9fe;
      --accent-rose: #e11d48;
      --accent-rose-bg: #ffe4e6;
      --border-color: #e2e8f0;
      --row-hover: #f1f5f9;
      --shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.08);
      --shadow-md: 0 4px 12px rgba(15, 23, 42, 0.08);
      --radius: 10px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      background-color: var(--bg-body);
      color: var(--text-main);
      line-height: 1.5;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    /* HEADER BANNER */
    .hero-header {
      background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);
      color: var(--text-light);
      padding: 24px 16px;
      border-bottom: 4px solid #3b82f6;
    }

    .container {
      max-width: 1360px;
      margin: 0 auto;
      width: 100%;
    }

    .hero-title {
      font-size: 1.45rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-bottom: 8px;
      color: #ffffff;
    }

    .hero-subtitle {
      font-size: 0.92rem;
      color: #cbd5e1;
      margin-bottom: 16px;
    }

    .meta-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .meta-badge {
      background: rgba(255, 255, 255, 0.12);
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: #f8fafc;
      padding: 5px 12px;
      border-radius: 999px;
      font-size: 0.8rem;
      font-weight: 600;
    }

    /* NAVIGATION TABS */
    .tabs-wrapper {
      background: var(--bg-card);
      border-bottom: 1px solid var(--border-color);
      position: sticky;
      top: 0;
      z-index: 50;
      box-shadow: var(--shadow-sm);
    }

    .tabs-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 6px;
      padding: 10px 16px;
      max-width: 1360px;
      margin: 0 auto;
    }

    .tab-btn {
      appearance: none;
      border: 1px solid var(--border-color);
      background: #f8fafc;
      color: var(--text-muted);
      padding: 10px 12px;
      border-radius: 8px;
      font-size: 0.86rem;
      font-weight: 700;
      cursor: pointer;
      transition: background-color 0.18s ease, color 0.18s ease, border-color 0.18s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      text-align: center;
    }

    .tab-btn:hover {
      background: #e2e8f0;
      color: #0f172a;
      border-color: #cbd5e1;
    }

    .tab-btn.active {
      background: var(--primary);
      color: #ffffff;
      border-color: var(--primary);
      box-shadow: 0 2px 6px rgba(29, 78, 216, 0.28);
    }

    .tab-count {
      background: rgba(15, 23, 42, 0.12);
      color: inherit;
      padding: 2px 7px;
      border-radius: 999px;
      font-size: 0.75rem;
    }

    .tab-btn.active .tab-count {
      background: rgba(255, 255, 255, 0.25);
      color: #ffffff;
    }

    /* CONTROLS & FILTERS */
    .controls-panel {
      background: var(--bg-card);
      margin: 16px auto;
      padding: 16px;
      border-radius: var(--radius);
      border: 1px solid var(--border-color);
      box-shadow: var(--shadow-sm);
    }

    .controls-grid {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr 1fr;
      gap: 10px;
      align-items: center;
    }

    .control-group {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .control-label {
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }

    .input-control, .select-control {
      width: 100%;
      padding: 9px 12px;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      font-size: 0.88rem;
      color: var(--text-main);
      background-color: #ffffff;
      outline: none;
      transition: border-color 0.15s ease;
    }

    .input-control:focus, .select-control:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(29, 78, 216, 0.12);
    }

    .stats-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 12px;
      padding-top: 12px;
      border-top: 1px dashed var(--border-color);
      font-size: 0.84rem;
      color: var(--text-muted);
    }

    .reset-btn {
      background: #f1f5f9;
      color: #0f172a;
      border: 1px solid #cbd5e1;
      padding: 5px 12px;
      border-radius: 6px;
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
    }

    .reset-btn:hover {
      background: #e2e8f0;
      color: #0f172a;
    }

    /* DATA TABLE (DESKTOP) */
    .table-container {
      background: var(--bg-card);
      border-radius: var(--radius);
      border: 1px solid var(--border-color);
      box-shadow: var(--shadow-sm);
      overflow: hidden;
      margin-bottom: 24px;
    }

    table.venue-table {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
    }

    table.venue-table thead th {
      background: #f1f5f9;
      color: #0f172a;
      font-size: 0.78rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.02em;
      padding: 12px 10px;
      text-align: left;
      border-bottom: 2px solid #cbd5e1;
      cursor: pointer;
      user-select: none;
      transition: background-color 0.15s ease;
    }

    table.venue-table thead th:hover {
      background: #e2e8f0;
      color: #0f172a;
    }

    table.venue-table tbody tr {
      border-bottom: 1px solid var(--border-color);
      background-color: #ffffff;
      transition: background-color 0.12s ease;
    }

    /* CHỐNG LỖI MÀU HOVER TUYỆT ĐỐI */
    table.venue-table tbody tr:hover {
      background-color: var(--row-hover);
      color: var(--text-main);
    }

    table.venue-table td {
      padding: 12px 10px;
      vertical-align: top;
      font-size: 0.85rem;
      color: var(--text-main);
      word-wrap: break-word;
      overflow-wrap: break-word;
    }

    /* COLUMN WIDTHS */
    .col-name { width: 17%; }
    .col-fit  { width: 8%; text-align: center; }
    .col-addr { width: 16%; }
    .col-dist { width: 9%; }
    .col-hour { width: 11%; }
    .col-spac { width: 11%; }
    .col-car  { width: 11%; }
    .col-must { width: 10%; }
    .col-pric { width: 7%; }

    /* BADGES & TYPOGRAPHY */
    .v-name {
      font-weight: 800;
      font-size: 0.94rem;
      color: #0f172a;
      margin-bottom: 4px;
      display: block;
    }

    .v-cat-tag {
      display: inline-block;
      font-size: 0.72rem;
      font-weight: 700;
      padding: 2px 7px;
      border-radius: 4px;
      background: var(--primary-soft);
      color: var(--primary);
    }

    .fit-pill {
      display: inline-block;
      font-weight: 800;
      font-size: 0.82rem;
      padding: 3px 8px;
      border-radius: 6px;
      background: var(--accent-green-bg);
      color: var(--accent-green);
      margin-bottom: 4px;
    }

    .star-box {
      display: block;
      font-weight: 700;
      color: var(--accent-amber);
      font-size: 0.82rem;
    }

    .dist-num {
      font-weight: 700;
      color: #0f172a;
      display: block;
    }

    .time-sub {
      font-size: 0.76rem;
      color: var(--text-muted);
    }

    .hour-text {
      font-weight: 600;
      display: block;
      margin-bottom: 4px;
    }

    .badge-late {
      display: inline-block;
      background: var(--accent-purple-bg);
      color: var(--accent-purple);
      font-size: 0.7rem;
      font-weight: 700;
      padding: 2px 6px;
      border-radius: 4px;
    }

    .badge-day {
      display: inline-block;
      background: var(--accent-amber-bg);
      color: var(--accent-amber);
      font-size: 0.7rem;
      font-weight: 700;
      padding: 2px 6px;
      border-radius: 4px;
    }

    .car-direct {
      color: #047857;
      font-weight: 700;
      font-size: 0.8rem;
    }

    .car-nearby {
      color: #1d4ed8;
      font-weight: 600;
      font-size: 0.8rem;
    }

    .price-val {
      font-weight: 800;
      color: #b91c1c;
      font-size: 0.84rem;
    }

    /* TRANSIT & PARKING MATRIX (TAB 4 EXTRA SECTION) */
    .transit-section {
      background: var(--bg-card);
      border: 2px solid #3b82f6;
      border-radius: var(--radius);
      padding: 16px;
      margin-bottom: 20px;
      box-shadow: var(--shadow-sm);
      display: none;
    }

    .transit-section.visible {
      display: block;
    }

    .transit-title {
      font-size: 1.05rem;
      font-weight: 800;
      color: #1e3a8a;
      margin-bottom: 10px;
    }

    .transit-cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }

    .transit-card {
      background: #f8fafc;
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 12px;
    }

    .transit-card h4 {
      font-size: 0.92rem;
      color: #0f172a;
      margin-bottom: 6px;
    }

    .transit-card p {
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-bottom: 4px;
    }

    /* EMPTY STATE */
    .empty-state {
      text-align: center;
      padding: 40px 16px;
      color: var(--text-muted);
      font-size: 0.95rem;
    }

    /* RESPONSIVE MOBILE: KHÔNG CUỘN NGANG, HIỂN THỊ DẠNG THẺ GỌN GÀNG */
    @media (max-width: 992px) {
      .controls-grid {
        grid-template-columns: 1fr 1fr;
      }
      .tabs-grid {
        grid-template-columns: 1fr 1fr;
      }
      .transit-cards {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 768px) {
      .hero-title {
        font-size: 1.2rem;
      }
      .controls-grid {
        grid-template-columns: 1fr;
      }
      .tabs-grid {
        grid-template-columns: 1fr;
      }
      table.venue-table thead {
        display: none;
      }
      table.venue-table,
      table.venue-table tbody,
      table.venue-table tr,
      table.venue-table td {
        display: block;
        width: 100%;
      }
      table.venue-table tbody tr {
        margin-bottom: 12px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        padding: 10px;
        box-shadow: var(--shadow-sm);
      }
      table.venue-table td {
        padding: 6px 4px;
        border-bottom: 1px dashed #e2e8f0;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 10px;
        text-align: right;
      }
      table.venue-table td:last-child {
        border-bottom: none;
      }
      table.venue-table td::before {
        content: attr(data-label);
        font-weight: 700;
        font-size: 0.76rem;
        color: var(--text-muted);
        text-transform: uppercase;
        text-align: left;
        flex: 0 0 38%;
      }
      .col-name, .col-fit, .col-addr, .col-dist, .col-hour, .col-spac, .col-car, .col-must, .col-pric {
        width: 100%;
        text-align: right;
      }
    }
  </style>
</head>
<body>

  <header class="hero-header">
    <div class="container">
      <h1 class="hero-title">CHUYÊN BIỆT QUÁN ĂN CHẤT LƯỢNG & NHÀ HÀNG LỊCH SỰ (2025 - 2026)</h1>
      <p class="hero-subtitle">Điểm mốc định vị: <strong>384 Lý Thái Tổ, Phường Vườn Lài, TP.HCM</strong> (Quận 10 cũ) • Tệp khách: 20 - 40 tuổi (Nhóm bạn, Gia đình trẻ, Tiếp khách)</p>
      <div class="meta-badges">
        <span class="meta-badge">✓ 84 Địa Điểm Xác Thực</span>
        <span class="meta-badge">✓ Có Bãi Đỗ Ô Tô / Hầm TTTM (&lt;150m)</span>
        <span class="meta-badge">✓ Không Gian Máy Lạnh &amp; Sân Vườn Thoáng</span>
        <span class="meta-badge">✓ Phân Tách Giờ Mở Khuya (&gt;22h) &amp; Sáng/Trưa/Tối</span>
      </div>
    </div>
  </header>

  <nav class="tabs-wrapper">
    <div class="tabs-grid">
      <button class="tab-btn active" onclick="switchTab(1)" id="tabBtn1">
        <span>1. Nhà Hàng &amp; Quán Việt Lịch Sự</span>
        <span class="tab-count" id="count1">0</span>
      </button>
      <button class="tab-btn" onclick="switchTab(2)" id="tabBtn2">
        <span>2. Lẩu, Nướng &amp; Hải Sản Tụ Tập</span>
        <span class="tab-count" id="count2">0</span>
      </button>
      <button class="tab-btn" onclick="switchTab(3)" id="tabBtn3">
        <span>3. Ẩm Thực Quốc Tế (Á - Âu - Hoa)</span>
        <span class="tab-count" id="count3">0</span>
      </button>
      <button class="tab-btn" onclick="switchTab(4)" id="tabBtn4">
        <span>4. Khu Ẩm Thực TTTM &amp; Di Chuyển</span>
        <span class="tab-count" id="count4">0</span>
      </button>
    </div>
  </nav>

  <main class="container" style="padding: 0 12px;">
    <!-- BẢNG PHƯƠNG ÁN DI CHUYỂN & BÃI ĐỖ Ô TÔ (HIỂN THỊ Ở TAB 4) -->
    <section class="transit-section" id="transitBox">
      <div class="transit-title">🚗 BẢNG PHƯƠNG ÁN DI CHUYỂN &amp; BÃI ĐỖ Ô TÔ TỪ MỐC 384 LÝ THÁI TỔ</div>
      <div class="transit-cards">
        <div class="transit-card">
          <h4>1. Vạn Hạnh Mall (11 Sư Vạn Hạnh - Cách 1.2 km | 5 phút)</h4>
          <p><strong>Lộ trình:</strong> 384 Lý Thái Tổ &rarr; Rẽ phải Sư Vạn Hạnh &rarr; Qua ngã tư 3/2 khoảng 200m.</p>
          <p><strong>Bãi đỗ ô tô:</strong> Sức chứa 350 ô tô tại tầng lửng 3, tầng 4 và tầng 5 (đường dốc xoắn ốc) + 3.000 xe máy.</p>
          <p><strong>Chi phí:</strong> Ô tô 20.000đ - 25.000đ/4 giờ đầu; Xe máy 4.000đ - 5.000đ/4 giờ đầu.</p>
        </div>
        <div class="transit-card">
          <h4>2. Hùng Vương Plaza (126 Hồng Bàng - Cách 1.8 km | 8 phút)</h4>
          <p><strong>Lộ trình:</strong> 384 Lý Thái Tổ &rarr; Nguyễn Tri Phương &rarr; Rẽ phải Hồng Bàng &rarr; Cổng đường Nguyễn Kim.</p>
          <p><strong>Bãi đỗ ô tô:</strong> Hầm B1 (50 ô tô, 1.200 xe máy) + Bãi ngoài trời cổng Nguyễn Kim (06:00 - 23:00, không giữ qua đêm).</p>
          <p><strong>Chi phí:</strong> Ô tô 20.000đ - 40.000đ/lượt. Dự phòng: Bãi xe 18 Nguyễn Kim hoặc 100Bis Hùng Vương.</p>
        </div>
        <div class="transit-card">
          <h4>3. Saigon Centre / Takashimaya &amp; Vincom Q.1 (Cách 3.5 km | 15 phút)</h4>
          <p><strong>Lộ trình:</strong> Lý Thái Tổ &rarr; Ngã 6 Cộng Hòa &rarr; Nguyễn Thị Minh Khai &rarr; Nam Kỳ Khởi Nghĩa &rarr; Lê Lợi.</p>
          <p><strong>Bãi đỗ ô tô:</strong> Hầm B2 Saigon Centre chứa 405 ô tô (vào cổng Nam Kỳ Khởi Nghĩa hoặc 180 Lý Tự Trọng vắng hơn).</p>
          <p><strong>Chi phí:</strong> 30.000đ/2h đầu (+20.000đ/h tiếp theo). Miễn phí gửi ô tô khi có hóa đơn mua sắm/ăn uống &gt; 1.000.000đ.</p>
        </div>
      </div>
    </section>

    <!-- BỘ LỌC & TÌM KIẾM -->
    <section class="controls-panel">
      <div class="controls-grid">
        <div class="control-group">
          <label class="control-label" for="searchInput">Tìm kiếm nhanh (Tên quán, Món ngon, Đường...)</label>
          <input type="text" id="searchInput" class="input-control" placeholder="VD: vịt quay, cua, Sư Vạn Hạnh, phòng VIP..." oninput="renderTable()">
        </div>
        <div class="control-group">
          <label class="control-label" for="timeFilter">Khung Giờ Hoạt Động</label>
          <select id="timeFilter" class="select-control" onchange="renderTable()">
            <option value="all">Tất cả khung giờ</option>
            <option value="late">🌙 Mở khuya (Sau 22:00 - 03:00)</option>
            <option value="morning">☀️ Mở ăn sáng sớm (Trước 08:00)</option>
            <option value="fullday">🕒 Phục vụ Trưa &amp; Tối chuẩn</option>
          </select>
        </div>
        <div class="control-group">
          <label class="control-label" for="carFilter">Hạ Tầng Đỗ Ô Tô</label>
          <select id="carFilter" class="select-control" onchange="renderTable()">
            <option value="all">Tất cả phương án đỗ xe</option>
            <option value="direct">🅿️ Đỗ trực tiếp / Hầm TTTM nội khu</option>
            <option value="nearby">🚶 Bãi gửi ô tô lân cận (&lt;150m)</option>
          </select>
        </div>
        <div class="control-group">
          <label class="control-label" for="priceFilter">Mức Giá / Người</label>
          <select id="priceFilter" class="select-control" onchange="renderTable()">
            <option value="all">Mọi phân khúc giá</option>
            <option value="low">Dưới 200.000 VNĐ</option>
            <option value="mid">200.000 - 400.000 VNĐ</option>
            <option value="high">Trên 400.000 VNĐ (Cao cấp/VIP)</option>
          </select>
        </div>
        <div class="control-group">
          <label class="control-label" for="sortSelect">Sắp Xếp Theo</label>
          <select id="sortSelect" class="select-control" onchange="renderTable()">
            <option value="fit_desc">Độ phù hợp: Cao &rarr; Thấp (%)</option>
            <option value="dist_asc">Khoảng cách: Gần &rarr; Xa (km)</option>
            <option value="star_desc">Đánh giá Sao: Cao &rarr; Thấp (★)</option>
            <option value="price_asc">Giá trung bình: Thấp &rarr; Cao</option>
            <option value="price_desc">Giá trung bình: Cao &rarr; Thấp</option>
          </select>
        </div>
      </div>
      <div class="stats-bar">
        <span id="resultStatus">Đang hiển thị dữ liệu...</span>
        <button class="reset-btn" onclick="resetFilters()">Đặt lại bộ lọc</button>
      </div>
    </section>

    <!-- BẢNG DỮ LIỆU CHÍNH -->
    <section class="table-container">
      <table class="venue-table">
        <thead>
          <tr>
            <th class="col-name" onclick="setSort('name')">Tên Nhà Hàng / Quán Ăn ↕</th>
            <th class="col-fit" onclick="setSort('fit_desc')">Phù Hợp &amp; Sao ↕</th>
            <th class="col-addr">Địa Chỉ (Phường Mới &amp; Cũ)</th>
            <th class="col-dist" onclick="setSort('dist_asc')">Cách Mốc ↕</th>
            <th class="col-hour">Giờ Mở - Đóng Cửa</th>
            <th class="col-spac">Quy Mô Không Gian</th>
            <th class="col-car">Chỗ Đỗ Ô Tô (&lt;150m)</th>
            <th class="col-must">Món Ngon Phải Gọi</th>
            <th class="col-pric" onclick="setSort('price_asc')">Giá/Người ↕</th>
          </tr>
        </thead>
        <tbody id="tableBody"></tbody>
      </table>
      <div id="emptyState" class="empty-state" style="display:none;">
        Không tìm thấy nhà hàng phù hợp với bộ lọc hiện tại. Vui lòng nhấn "Đặt lại bộ lọc".
      </div>
    </section>
