    ];

    let currentTab = 1;

    function updateCounts() {
      for (let t = 1; t <= 4; t++) {
        const cnt = DB.filter(x => x.t === t).length;
        document.getElementById('count' + t).textContent = cnt;
      }
    }

    function switchTab(tabIndex) {
      currentTab = tabIndex;
      for (let t = 1; t <= 4; t++) {
        const btn = document.getElementById('tabBtn' + t);
        if (t === tabIndex) btn.classList.add('active');
        else btn.classList.remove('active');
      }
      const transitBox = document.getElementById('transitBox');
      if (tabIndex === 4) transitBox.classList.add('visible');
      else transitBox.classList.remove('visible');
      renderTable();
    }

    function setSort(sortVal) {
      const sel = document.getElementById('sortSelect');
      if (sortVal === 'name') {
        sel.value = 'fit_desc';
      } else {
        sel.value = sortVal;
      }
      renderTable();
    }

    function resetFilters() {
      document.getElementById('searchInput').value = '';
      document.getElementById('timeFilter').value = 'all';
      document.getElementById('carFilter').value = 'all';
      document.getElementById('priceFilter').value = 'all';
      document.getElementById('sortSelect').value = 'fit_desc';
      renderTable();
    }

    function renderTable() {
      const q = document.getElementById('searchInput').value.trim().toLowerCase();
      const timeF = document.getElementById('timeFilter').value;
      const carF = document.getElementById('carFilter').value;
      const priceF = document.getElementById('priceFilter').value;
      const sortF = document.getElementById('sortSelect').value;

      let list = DB.filter(item => item.t === currentTab);

      if (q) {
        list = list.filter(item =>
          item.n.toLowerCase().includes(q) ||
          item.c.toLowerCase().includes(q) ||
          item.a.toLowerCase().includes(q) ||
          item.ms.toLowerCase().includes(q) ||
          item.sc.toLowerCase().includes(q)
        );
      }

      if (timeF === 'late') list = list.filter(item => item.l === true);
      else if (timeF === 'morning') list = list.filter(item => item.e === true);
      else if (timeF === 'fullday') list = list.filter(item => !item.e || item.l);

      if (carF === 'direct') list = list.filter(item => item.pt === 'direct');
      else if (carF === 'nearby') list = list.filter(item => item.pt === 'nearby');

      if (priceF === 'low') list = list.filter(item => item.pMin < 200);
      else if (priceF === 'mid') list = list.filter(item => item.pMin >= 150 && item.pMax <= 450);
      else if (priceF === 'high') list = list.filter(item => item.pMax >= 450);

      list.sort((a, b) => {
        if (sortF === 'fit_desc') return b.f - a.f || b.s - a.s;
        if (sortF === 'dist_asc') return a.d - b.d;
        if (sortF === 'star_desc') return b.s - a.s || b.f - a.f;
        if (sortF === 'price_asc') return a.pMin - b.pMin;
        if (sortF === 'price_desc') return b.pMax - a.pMax;
        return 0;
      });

      const tbody = document.getElementById('tableBody');
      const emptyState = document.getElementById('emptyState');
      tbody.innerHTML = '';

      if (list.length === 0) {
        emptyState.style.display = 'block';
      } else {
        emptyState.style.display = 'none';
        list.forEach(v => {
          const tr = document.createElement('tr');
          const timeBadge = v.l
            ? '<span class="badge-late">🌙 Mở khuya &gt;22h</span>'
            : (v.e ? '<span class="badge-day">☀️ Mở ăn sáng</span>' : '<span class="badge-day">🕒 Trưa &amp; Tối</span>');
          const carClass = v.pt === 'direct' ? 'car-direct' : 'car-nearby';
          const carIcon = v.pt === 'direct' ? '🅿️ Đỗ trực tiếp/Hầm: ' : '🚶 Bãi xe &lt;150m: ';

          tr.innerHTML = `
            <td class="col-name" data-label="Tên Nhà Hàng">
              <div>
                <span class="v-name">${v.n}</span>
                <span class="v-cat-tag">${v.c}</span>
              </div>
            </td>
            <td class="col-fit" data-label="Độ Phù Hợp & Sao">
              <div>
                <span class="fit-pill">${v.f}%</span>
                <span class="star-box">${v.s.toFixed(1)} ★</span>
              </div>
            </td>
            <td class="col-addr" data-label="Địa Chỉ">${v.a}</td>
            <td class="col-dist" data-label="Khoảng Cách">
              <div>
                <span class="dist-num">${v.d.toFixed(1)} km</span>
                <span class="time-sub">~${v.m} đi xe</span>
              </div>
            </td>
            <td class="col-hour" data-label="Giờ Hoạt Động">
              <div>
                <span class="hour-text">${v.h}</span>
                ${timeBadge}
              </div>
            </td>
            <td class="col-spac" data-label="Quy Mô Không Gian">${v.sc}</td>
            <td class="col-car" data-label="Chỗ Đỗ Ô Tô">
              <span class="${carClass}">${carIcon}${v.pk}</span>
            </td>
            <td class="col-must" data-label="Món Phải Gọi"><strong>${v.ms}</strong></td>
            <td class="col-pric" data-label="Khoảng Giá/Người">
              <span class="price-val">${v.pr}</span>
            </td>
          `;
          tbody.appendChild(tr);
        });
      }

      document.getElementById('resultStatus').innerHTML =
        `Đang hiển thị <strong>${list.length}</strong> địa điểm trong Tab hiện tại (Tổng hệ thống: <strong>${DB.length}</strong> nhà hàng &amp; quán ăn chất lượng quanh 384 Lý Thái Tổ).`;
    }

    // Khởi tạo giao diện
    updateCounts();
    renderTable();
  </script>
